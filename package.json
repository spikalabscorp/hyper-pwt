{
  "name": "hyper-pwt",
  "version": "0.5.0",
  "description": "A faster, more modern, superior alternative for Mendix PWT.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spikalabscorp/hyper-pwt.git"
  },
  "scripts": {
    "build": "rslib build",
    "watch": "rslib build --watch",
    "start": "pnpm build && node ./dist/cli.cjs",
    "test:unit:web": "node ./tools/verify-unit-web.mjs",
    "package": "pnpm build && pnpm pack",
    "prepare": "husky",
    "lint": "oxfmt --check . && oxlint .",
    "lint:fix": "oxfmt --write . && oxlint --fix ."
  },
  "lint-staged": {
    "*": [
      "oxfmt --write --no-error-on-unmatched-pattern",
      "oxlint --fix --no-error-on-unmatched-pattern"
    ]
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./src/configurations/typescript/tsconfig.base": "./src/configurations/typescript/tsconfig.base.json"
  },
  "bin": {
    "hyper-pwt": "dist/cli.cjs",
    "pluggable-widgets-tools": "dist/cli.cjs"
  },
  "keywords": [
    "mendix",
    "pwt",
    "mendix-pwt",
    "pluggable-widgets-tools"
  ],
  "author": "spikalabs Co, Ltd.",
  "license": "MIT",
  "packageManager": "pnpm@11.11.0",
  "devDependencies": {
    "@rslib/core": "0.23.2",
    "@types/node": "26.1.1",
    "husky": "9.1.7",
    "type-fest": "5.8.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@swc/core": "1.15.43",
    "@swc/jest": "0.2.39",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-react": "6.0.3",
    "chalk": "5.6.2",
    "fast-xml-parser": "5.9.3",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "mendix": "11.12.0",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "vite": "8.1.4",
    "zip-a-folder": "6.1.2"
  },
  "files": [
    "dist/**/*",
    "package.json",
    "LICENSE",
    "src/configurations/hotReload/**/*",
    "src/configurations/typescript/**/*",
    "test-config/**/*",
    "custom_widget.xsd"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
