{
    "name": "@repixelcorp/hyper-pwt",
    "version": "0.5.0",
    "description": "A faster, more modern, superior alternative for Mendix PWT.",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/spikalabscorp/hyper-pwt.git"
    },
    "scripts": {
        "build": "rslib build",
        "watch": "rslib build --watch",
        "start": "pnpm build && node ./dist/cli.cjs",
        "package": "pnpm build && pnpm pack",
        "prepare": "husky",
        "lint": "oxfmt --check . && oxlint .",
        "lint:fix": "oxfmt --write . && oxlint --fix ."
    },
    "lint-staged": {
        "*": [
            "oxfmt --write --no-error-on-unmatched-pattern",
            "oxlint --fix --no-error-on-unmatched-pattern"
        ]
    },
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs",
            "types": "./dist/index.d.ts"
        },
        "./src/configurations/typescript/tsconfig.base": "./src/configurations/typescript/tsconfig.base.json"
    },
    "bin": {
        "hyper-pwt": "dist/cli.cjs",
        "pluggable-widgets-tools": "dist/cli.cjs"
    },
    "keywords": [
        "mendix",
        "pwt",
        "mendix-pwt",
        "pluggable-widgets-tools"
    ],
    "author": "Repixel Co., Ltd.",
    "license": "MIT",
    "packageManager": "pnpm@10.33.3",
    "devDependencies": {
        "@rslib/core": "0.21.3",
        "@types/node": "25.6.0",
        "husky": "9.1.7",
        "type-fest": "5.6.0",
        "typescript": "6.0.3"
    },
    "dependencies": {
        "@vitejs/plugin-react": "6.0.1",
        "chalk": "5.6.2",
        "fast-xml-parser": "5.7.3",
        "mendix": "10.24.104498",
        "oxfmt": "0.48.0",
        "oxlint": "1.63.0",
        "rollup-plugin-typescript2": "0.37.0",
        "vite": "8.0.10",
        "zip-a-folder": "6.1.1"
    },
    "files": [
        "dist/**/*",
        "package.json",
        "LICENSE",
        "src/configurations/hotReload/**/*",
        "src/configurations/typescript/**/*",
        "custom_widget.xsd"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "engines": {
        "node": ">=24"
    },
    "pnpm": {
        "overrides": {
            "@rollup/pluginutils>picomatch": "2.3.2",
            "rollup": "4.60.3",
            "vite>yaml": "2.8.4"
        }
    }
}
